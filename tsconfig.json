{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "automation/**/*.ts",
    "ai/**/*.ts",
    "apps/**/*.ts",
    "scripts/**/*.ts",
    "playwright.config.ts"
  ]
}